<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd" id="WebApp_ID" version="4.0">
  <display-name>WebApplication_TermProject_Sandbox</display-name>

  <!--
    Servlet 매핑은 @WebServlet 애노테이션으로 둔다 (Servlet 4.0).
    web.xml 에는 순서가 의미를 갖는 필터 체인만 적는다.
  -->

  <!-- ===========================================================
       필터 체인 — 선언 순서가 실행 순서다 (ERD § 5)

         1. EncodingFilter        UTF-8. 누구보다 먼저 와야 파라미터가 안 깨진다
         2. JspDirectAccessFilter .jsp 직접 접근 차단 (REQUEST 디스패치만)
         3. ShopFilter            점검 모드. ★ AdminFilter 보다 먼저
         4. LoginFilter           로그인 필요 영역
         5. AdminFilter           /admin/*  role IN ('ADMIN','DEV')
         6. DevFilter             /dev/*    role = 'DEV'

       ★ 3번이 5번보다 뒤로 가면 점검 모드에서 관리자까지 막혀
         점검을 해제할 수 없게 된다.
       =========================================================== -->

  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>shop.filter.EncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>JspDirectAccessFilter</filter-name>
    <filter-class>shop.filter.JspDirectAccessFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>JspDirectAccessFilter</filter-name>
    <url-pattern>/*</url-pattern>
    <!-- REQUEST 만 — Servlet 의 forward(FORWARD) 는 통과해야 뷰가 렌더된다 -->
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>

  <filter>
    <filter-name>ShopFilter</filter-name>
    <filter-class>shop.filter.ShopFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>ShopFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>LoginFilter</filter-name>
    <filter-class>shop.filter.LoginFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>LoginFilter</filter-name>
    <url-pattern>/cart/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>LoginFilter</filter-name>
    <url-pattern>/order/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>LoginFilter</filter-name>
    <url-pattern>/mypage/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>LoginFilter</filter-name>
    <url-pattern>/wish/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>AdminFilter</filter-name>
    <filter-class>shop.filter.AdminFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AdminFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>DevFilter</filter-name>
    <filter-class>shop.filter.DevFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>DevFilter</filter-name>
    <url-pattern>/dev/*</url-pattern>
  </filter-mapping>

  <!--
    JSP 인코딩을 전체에 고정한다.
    common/header.jsp · footer.jsp 는 정적 include 조각이라 page 지시자가 없고,
    그러면 조각이 기본 인코딩(ISO-8859-1)으로 읽혀 한글이 깨진다.
  -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
    </jsp-property-group>
  </jsp-config>

  <!-- 세션 유지 시간 (분) -->
  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <!--
    welcome-file 을 두지 않는다. MainServlet 이 빈 문자열("") 패턴으로
    컨텍스트 루트에 직접 매핑돼 있어 / 요청을 그대로 받는다 (Servlet 4.0 § 12.2).
    index.jsp 를 두면 모델 없이 렌더되는 입구가 하나 더 생긴다.
  -->

  <error-page>
    <error-code>404</error-code>
    <location>/common/error404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/common/error500.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/common/error500.jsp</location>
  </error-page>
</web-app>
