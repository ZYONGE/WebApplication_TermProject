# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Java build files
*.class

# Jar — 일반 jar는 제외하되, WAR 배포에 포함돼야 하는 WEB-INF/lib는 추적
*.jar
!WebContents/WEB-INF/lib/*.jar

# Deployment artifacts (Eclipse Export → WAR file 결과물)
*.war
*.ear

# Eclipse build output (Dynamic Web Project 기본 출력 경로)
/build/
/bin/
/out/
/target/

# Eclipse workspace metadata
# .project / .classpath / .settings/ 는 Import 시 필요하므로 추적
.metadata/
RemoteSystemsTempFiles/
Servers/
.recommenders/
*.launch

# IDE specific
.idea/
*.iml
.vscode/

# Tomcat runtime
/work/
/temp/
/logs/

# DB 접속 정보 — context.xml.example 을 복사해 context.xml 로 사용
WebContents/META-INF/context.xml

# 관리자 상품 이미지 업로드 경로 (런타임 생성 파일)
WebContents/upload/*
!WebContents/upload/.gitkeep

# Logs and temp files
*.log
*.tmp
*.bak
*.swp
